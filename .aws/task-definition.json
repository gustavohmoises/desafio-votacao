          "value": "Rs69ArH3}#Yt"
        },
        {
          "name": "KAFKA_BOOTSTRAP_SERVERS",
          "value": "b-2.votacaokafka.o1tl3p.c6.kafka.us-east-2.amazonaws.com:9092,b-1.votacaokafka.o1tl3p.c6.kafka.us-east-2.amazonaws.com:9092"
